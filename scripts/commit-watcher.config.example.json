{
  "repo_path": "~/code/your-repo",
  "branch": "main",
  "remote": "origin",
  "poll_seconds": 30,
  "backfill_minutes": 30,
  "backfill_stagger_ms": 1500,
  "path_palette_rules": [
    {"prefix": "src/server/", "palette": "green"},
    {"prefix": "src/app/",    "palette": "magenta"},
    {"prefix": "src/schemas/", "palette": "amber"},
    {"prefix": "infrastructure/", "palette": "red"},
    {"prefix": "", "palette": "cyan"}
  ]
}
