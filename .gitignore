# Claude Code runtime state — PIDs, session files, agent state.
# Not the same as claude/ (no dot) which is intentionally tracked config.
.claude/

# Defense-in-depth: never track Claude Code transcripts or session data.
# Live transcripts live in ~/.claude/projects/ outside this repo, but in
# case anyone ever symlinks or copies one in, these patterns block commits.
*.jsonl
projects/
tool-results/
# Org context — private per-org engineering standards, never committed.
org/
# Machine-local secrets / overrides. The canonical file lives at ~/.zshenv.local
# outside this repo, but this catches any *.local file dropped inside.
*.local
# Per-lane dev-server port (wt writes <wt>/.env.local.port; .local glob misses
# it — trailing .port). Never commit lane-local runtime state.
.env.local.port
# macOS noise
.DS_Store

# Caveman compress backup
*.original.md
