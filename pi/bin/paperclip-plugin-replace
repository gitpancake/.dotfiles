#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE' >&2
Usage: paperclip-plugin-replace <plugin-key> <package-name> <version> [--api-base URL]

Replaces a Paperclip plugin through the Board API while preserving plugin config.
Token lookup: PAPERCLIP_BOARD_TOKEN, PAPERCLIP_API_KEY, or ~/.paperclip/auth.json.
USAGE
}

plugin_key="${1:-}"; package_name="${2:-}"; version="${3:-}"
if [[ "$plugin_key" == "-h" || "$plugin_key" == "--help" ]]; then
  usage
  exit 0
fi
if [[ -z "$plugin_key" || -z "$package_name" || -z "$version" ]]; then
  usage
  exit 2
fi
shift 3
api_base="${PAPERCLIP_API_BASE:-${PAPERCLIP_URL:-https://paperclip-production-30dec.up.railway.app}}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --api-base) api_base="${2:-}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unexpected arg: $1" >&2; usage; exit 2 ;;
  esac
  shift
done
api_base="${api_base%/}"

python3 - "$api_base" "$plugin_key" "$package_name" "$version" <<'PY'
import json, os, sys, urllib.error, urllib.request
from pathlib import Path

api_base, plugin_key, package_name, version = sys.argv[1:]

def read_auth_token():
    token = os.environ.get('PAPERCLIP_BOARD_TOKEN') or os.environ.get('PAPERCLIP_API_KEY')
    if token:
        return token
    path = Path.home() / '.paperclip' / 'auth.json'
    if not path.exists():
        raise SystemExit('No Paperclip token found. Set PAPERCLIP_BOARD_TOKEN or login to Paperclip.')
    data = json.loads(path.read_text())
    token = data.get('credentials', {}).get(api_base, {}).get('token')
    if not token:
        raise SystemExit(f'No token for {api_base} in ~/.paperclip/auth.json')
    return token

token = read_auth_token()

def request(method, path, body=None, ok=(200, 201)):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(api_base + path, data=data, method=method)
    req.add_header('authorization', 'Bearer ' + token)
    req.add_header('content-type', 'application/json')
    try:
        with urllib.request.urlopen(req, timeout=120) as res:
            text = res.read().decode()
            return json.loads(text) if text else None
    except urllib.error.HTTPError as e:
        detail = e.read().decode()
        raise SystemExit(f'{method} {path} failed: HTTP {e.code} {detail}')

def compact(plugin):
    if not plugin:
        return None
    manifest = plugin.get('manifestJson') or {}
    return {
        'id': plugin.get('id'),
        'pluginKey': plugin.get('pluginKey'),
        'packageName': plugin.get('packageName'),
        'version': plugin.get('version'),
        'manifestVersion': manifest.get('version'),
        'status': plugin.get('status'),
        'lastError': plugin.get('lastError'),
    }

config = None
try:
    cfg = request('GET', f'/api/plugins/{urllib.parse.quote(plugin_key)}/config')
    if isinstance(cfg, dict):
        config = cfg.get('configJson')
except SystemExit:
    config = None

try:
    before = request('GET', f'/api/plugins/{urllib.parse.quote(plugin_key)}')
    print(json.dumps({'step': 'inspect', 'plugin': compact(before)}, indent=2))
    removed = request('DELETE', f'/api/plugins/{urllib.parse.quote(plugin_key)}?purge=true')
    print(json.dumps({'step': 'remove', 'plugin': compact(removed)}, indent=2))
except SystemExit as exc:
    if 'HTTP 404' not in str(exc):
        raise

installed = request('POST', '/api/plugins/install', {'packageName': package_name, 'version': version})
print(json.dumps({'step': 'install', 'plugin': compact(installed)}, indent=2))

if config:
    request('POST', f'/api/plugins/{urllib.parse.quote(plugin_key)}/config', {'configJson': config})
    print(json.dumps({'step': 'restore_config', 'restored': True}, indent=2))
else:
    print(json.dumps({'step': 'restore_config', 'restored': False}, indent=2))
PY
