#!/usr/bin/env bash
# Slack-alerts-style commit feed across $CODE_DIR (default ~/Documents/code).
# Default: one-shot render (intended for `watch -tcn5 git-watch`).
# `git-watch live`: spawn `watch -tcn5` itself.
set -euo pipefail

script="$HOME/.dotfiles/scripts/git-watch.py"

case "${1:-}" in
  live)
    shift
    exec watch -tcn5 /usr/bin/env python3 "$script" "$@"
    ;;
  *)
    exec /usr/bin/env python3 "$script" "$@"
    ;;
esac
