#!/usr/bin/env bash
# wt — spin up a worktree lane in one command.
#
# Usage:
#   wt [--type <prefix>] <task-slug-or-ticket>     # single lane (default)
#   wt --dag [--type <prefix>] <TICKET>            # parse plan DAG, spawn ready-set lanes
#   wt --resolve [--type <prefix>] <TICKET>        # re-spawn ready-set after slices merged
#
# Single-lane behavior:
#   wt team-1530                    # raw slug → worktree only, no auto-kickoff
#   wt TEAM-1530                    # bare Linear ticket → descriptor pulled from
#                                   ~/.claude/plans/TEAM-1530.md heading; kicks off
#                                   /ticket-pickup if no plan yet
#   wt TEAM-1530-pr-feedback        # explicit descriptor; plan file matches slug
#   wt --type fix TEAM-1530-bug-x   # branch fix/team-1530-bug-x
#
# Type prefix defaults to `feature`. Override with --type or WT_TYPE env.
# Common values: feature, fix, chore, task, refactor.
#
# DAG mode:
#   wt --dag TEAM-1530  → reads ~/.claude/plans/TEAM-1530.md slice-dag block,
#                       spawns lanes only for slices whose `needs` are merged
#                       and whose `touches` don't conflict with already-ready
#                       siblings. No DAG block / single slice → falls back to
#                       single-lane.
#   wt --resolve TEAM-1530 → after some slices merge, re-compute ready set and
#                       spawn newly-unblocked lanes. Skips slices already in
#                       flight (worktree exists).
#
# Env knobs:
#   WT_TYPE=          branch type prefix (default: feature)
#   WT_NO_FETCH=1     skip pre-spawn fetch + ff
#   WT_LAYOUT=        pane|window|session (default: window)
#   WT_CLAUDE='claude'  full bypass of model/permission flags
#   WT_MODEL=opus     model override (default: sonnet)
#   WT_DRY_RUN=1      DAG mode only — print what would spawn, don't actually
#   WT_DAG=1          equivalent to --dag flag
#
# Effect (per lane):
#   - Worktree at <repo>/.claude/worktrees/<slug>
#   - Branch <type>/<slug> off current HEAD (skipped if branch already exists)
#   - Per-lane port stamped in .env.local.port (3100 + lane index)
#   - .claude/agent-state seeded as IDLE (visible to agent-board)
#   - In tmux: opens new window running claude, with optional initial prompt
#   - Outside tmux: prints the path so you can cd in manually

set -euo pipefail

# ---- arg parse -------------------------------------------------------------

mode="single"
type_prefix="${WT_TYPE:-feature}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dag)     mode="dag";     shift ;;
    --resolve) mode="resolve"; shift ;;
    --type)
      [[ -z "${2:-}" ]] && { echo "wt: --type requires an argument" >&2; exit 1; }
      type_prefix="$2"; shift 2 ;;
    --type=*)  type_prefix="${1#--type=}"; shift ;;
    --)        shift; break ;;
    *)         break ;;
  esac
done
[[ "${WT_DAG:-}" == "1" && "$mode" == "single" ]] && mode="dag"

# Sanitize type prefix: lowercase, alnum + dash only.
type_prefix=$(printf '%s' "$type_prefix" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]//g')
[[ -z "$type_prefix" ]] && { echo "wt: invalid --type prefix" >&2; exit 1; }

raw=${1:-}
[[ -z "$raw" ]] && { echo "usage: wt [--dag|--resolve] [--type <prefix>] <task-slug-or-ticket>" >&2; exit 1; }

# Derive a slug descriptor from the plan's first heading.
#   '# TEAM-1530 — Add foo bar' → 'add-foo-bar'
derive_descriptor_from_plan() {
  local plan_file=$1 ticket_upper=$2 title desc
  [[ -f "$plan_file" ]] || return 1
  title=$(awk '/^# /{ sub(/^# +/, ""); print; exit }' "$plan_file")
  [[ -z "$title" ]] && return 1
  # Strip leading "TICKET" plus optional separator (— : -).
  title=$(printf '%s' "$title" | sed -E "s/^${ticket_upper}[[:space:]]*([—:-][[:space:]]*)?//I")
  desc=$(printf '%s' "$title" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-50 \
    | sed -E 's/-+$//')
  [[ -z "$desc" ]] && return 1
  printf '%s' "$desc"
}

# Detect Linear-style ticket: TEAM-NNNN, optionally with -descriptor suffix.
#   TEAM-1530              → ticket=TEAM-1530, slug=team-1530-<derived>, plan=TEAM-1530.md
#   TEAM-1530-pr-feedback  → ticket=TEAM-1530, slug=team-1530-pr-feedback,
#                          plan=TEAM-1530-pr-feedback.md
#   raw-feature-x        → no ticket, slug=raw-feature-x
ticket=""
plan_slug=""
if [[ "$raw" =~ ^([A-Za-z]+-[0-9]+)(-.+)?$ ]]; then
  ticket=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
  ticket_lower=$(printf '%s' "$ticket" | tr '[:upper:]' '[:lower:]')
  tail="${BASH_REMATCH[2]:-}"
  if [[ -n "$tail" ]]; then
    descriptor="${tail#-}"
    slug="${ticket_lower}-${descriptor}"
    plan_slug="${ticket}${tail}"
  else
    plan_slug="$ticket"
    plan_file="$HOME/.claude/plans/${ticket}.md"
    descriptor=$(derive_descriptor_from_plan "$plan_file" "$ticket" || true)
    if [[ -z "$descriptor" ]]; then
      slug="$ticket_lower"
    else
      slug="${ticket_lower}-${descriptor}"
    fi
  fi
else
  slug=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')
fi

repo=$(git rev-parse --show-toplevel 2>/dev/null) \
  || { echo "wt: not inside a git repo" >&2; exit 1; }

wt_dir="$repo/.claude/worktrees"
mkdir -p "$wt_dir"

# Pre-spawn fetch + ff. Skip with WT_NO_FETCH=1.
if [[ -z "${WT_NO_FETCH:-}" ]]; then
  git -C "$repo" fetch --quiet origin || echo "wt: warning, fetch failed" >&2
  current=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
  if [[ "$current" == "main" || "$current" == "master" ]]; then
    if git -C "$repo" merge-base --is-ancestor HEAD "origin/$current" 2>/dev/null; then
      git -C "$repo" merge --ff-only "origin/$current" \
        || echo "wt: warning, fast-forward of $current failed (dirty tree?)" >&2
    fi
  fi
fi

layout="${WT_LAYOUT:-window}"

# ---- lane spawn helper -----------------------------------------------------
# Args: <slug> <branch> <wt_path> <initial-prompt-or-empty> [tmux-label]
spawn_lane() {
  local s_slug=$1 s_branch=$2 s_wt=$3 s_initial=$4
  local s_label="${5:-$s_slug}"

  if [[ "${WT_DRY_RUN:-}" == "1" ]]; then
    echo "wt[dry-run]: would spawn lane"
    echo "  slug:     $s_slug"
    echo "  branch:   $s_branch"
    echo "  worktree: $s_wt"
    [[ -n "$s_initial" ]] && echo "  kickoff:  $s_initial"
    return 0
  fi

  if [[ ! -d "$s_wt" ]]; then
    if git -C "$repo" rev-parse --verify "$s_branch" >/dev/null 2>&1; then
      git -C "$repo" worktree add "$s_wt" "$s_branch"
    else
      git -C "$repo" worktree add "$s_wt" -b "$s_branch"
    fi
  fi

  local existing port
  existing=$(find "$wt_dir" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
  port=$((3099 + existing))
  printf 'PORT=%s\n' "$port" > "$s_wt/.env.local.port"

  mkdir -p "$s_wt/.claude"
  echo "IDLE" > "$s_wt/.claude/agent-state"

  if [[ ! -f "$s_wt/.claude/settings.local.json" ]]; then
    cat > "$s_wt/.claude/settings.local.json" <<'JSON'
{
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false
  }
}
JSON
  fi

  local claude_bin claude_cmd
  claude_bin="${WT_CLAUDE:-claude --dangerously-skip-permissions --model ${WT_MODEL:-sonnet}}"
  claude_cmd="$claude_bin"
  [[ -n "$s_initial" ]] && claude_cmd="$claude_bin $(printf '%q' "$s_initial")"

  if [[ -n "${TMUX:-}" ]]; then
    case "$layout" in
      pane)
        tmux split-window -h -c "$s_wt" "$claude_cmd"
        tmux select-pane -T "$s_label" 2>/dev/null || true
        ;;
      window)
        tmux new-window -n "$s_label" -c "$s_wt" "$claude_cmd"
        ;;
      session)
        tmux new-session -d -s "wt-$s_label" -c "$s_wt" "$claude_cmd"
        echo "wt: detached session 'wt-$s_label'. Attach: tmux attach -t wt-$s_label"
        ;;
      *)
        echo "wt: unknown WT_LAYOUT=$layout (expected pane|window|session)" >&2
        exit 1
        ;;
    esac
  else
    echo "wt: not in tmux."
    echo "  worktree: $s_wt"
    echo "  port:     $port"
    echo "  branch:   $s_branch"
    [[ -n "$s_initial" ]] && echo "  kickoff:  $claude_cmd"
  fi
}

# ---- single-lane mode (default, unchanged behavior) -----------------------

if [[ "$mode" == "single" ]]; then
  wt_path="$wt_dir/$slug"
  branch="${type_prefix}/${slug}"

  initial=""
  if [[ -n "$ticket" ]]; then
    plan="$HOME/.claude/plans/${plan_slug}.md"
    review_rule="Review findings: apply blocker/major fixes directly in the PR branch (commit + push), do NOT post them as PR comments. Never run \`gh pr comment\`, \`gh pr review --comment\`, or any \`gh\` command that writes to the PR conversation. Minor/NB findings: include in the final report only."
    if [[ -f "$plan" ]]; then
      initial="Autonomous mode. Plan at ${plan}. Read it. Implement every slice end-to-end: per slice run type-check + tests (use \`bun test\` in example-org-agent), commit per layer (schema → backend → frontend), then move on. After the final slice, run /ship to open the PR and run a full review. ${review_rule} Stop only when the PR is open and review-driven fixes are pushed. If you hit a genuine blocker (ambiguity not resolvable from the plan, repeated test failure on the same root cause, missing credential), stop and report — do not guess. Do not ask for confirmation between slices."
    else
      initial="Autonomous mode. Run /ticket-pickup ${ticket} first to scope (it will write ~/.claude/plans/${ticket}.md). Then implement every slice end-to-end per the plan: type-check + tests per slice, commit per layer, no inter-slice confirmation. After the final slice, run /ship. ${review_rule} Stop only when the PR is open and review-driven fixes are pushed. Stop early only on a genuine blocker (ambiguity, repeated failure, missing credential)."
    fi
  fi

  spawn_lane "$slug" "$branch" "$wt_path" "$initial" "${ticket:-$slug}"
  exit 0
fi

# ---- DAG modes -------------------------------------------------------------

[[ -z "$ticket" ]] && { echo "wt: --dag/--resolve requires a Linear-style ticket ID" >&2; exit 1; }

dag_parser="$HOME/.claude/scripts/dag-parse.sh"
[[ -x "$dag_parser" ]] || dag_parser="$HOME/.dotfiles/claude/scripts/dag-parse.sh"

# Run parser. Separate stdout (TSV) from stderr (errors).
# Export WT_TYPE so dag-parse stamps the right branch prefix.
export WT_TYPE="$type_prefix"
set +e
parse_err=$("$dag_parser" "$ticket" 2>&1 >/dev/null)
tsv=$("$dag_parser" "$ticket" 2>/dev/null)
parse_rc=$?
set -e

case "$parse_rc" in
  0) : ;;
  2)
    echo "wt: $parse_err" >&2
    exit 2
    ;;
  3)
    echo "wt: no slice-dag block in plan — falling back to single-lane mode" >&2
    wt_path="$wt_dir/$slug"
    branch="${type_prefix}/${slug}"
    plan="$HOME/.claude/plans/${plan_slug}.md"
    review_rule="Review findings: apply blocker/major fixes directly in the PR branch (commit + push), do NOT post them as PR comments. Never run \`gh pr comment\`, \`gh pr review --comment\`, or any \`gh\` command that writes to the PR conversation. Minor/NB findings: include in the final report only."
    initial="Autonomous mode. Plan at ${plan}. Read it. Implement every slice end-to-end: per slice run type-check + tests, commit per layer, then move on. After the final slice, run /ship. ${review_rule} Stop only when the PR is open and review-driven fixes are pushed."
    spawn_lane "$slug" "$branch" "$wt_path" "$initial" "$ticket"
    exit 0
    ;;
  4)
    echo "wt: $parse_err" >&2
    exit 4
    ;;
  *)
    echo "wt: dag-parse failed (rc=$parse_rc): $parse_err" >&2
    exit "$parse_rc"
    ;;
esac

[[ -z "$tsv" ]] && { echo "wt: dag-parse returned no slices" >&2; exit 4; }

slice_count=$(printf '%s\n' "$tsv" | wc -l | tr -d ' ')
if [[ "$slice_count" -le 1 ]]; then
  echo "wt: only one slice in DAG — falling back to single-lane mode"
  wt_path="$wt_dir/$slug"
  branch="${type_prefix}/${slug}"
  plan="$HOME/.claude/plans/${plan_slug}.md"
  initial="Autonomous mode. Plan at ${plan}. Single-slice plan. Implement it, run /ship."
  spawn_lane "$slug" "$branch" "$wt_path" "$initial" "$ticket"
  exit 0
fi

# Determine which slices are already merged. Heuristic:
#   - branch <type>/<slug>-<id> exists AND is reachable from feature branch HEAD,
#     OR
#   - branch doesn't exist but a marker file says merged (future-proofing).
# Feature branch == <type>/<slug> (matches single-lane convention; for DAG plans
# this is the integration branch the slice lanes merge into).
feature_branch="${type_prefix}/${slug}"
feature_ref=""
if git -C "$repo" rev-parse --verify "$feature_branch" >/dev/null 2>&1; then
  feature_ref="$feature_branch"
else
  # Cockpit HEAD is the implicit base; treat its history as "merged".
  feature_ref="HEAD"
fi

is_merged() {
  local s_branch=$1
  git -C "$repo" rev-parse --verify "$s_branch" >/dev/null 2>&1 || return 1
  git -C "$repo" merge-base --is-ancestor "$s_branch" "$feature_ref" 2>/dev/null
}

# Build parallel arrays (bash 3.2 — no associative).
ids=();    names=();   needs_arr=(); touches_arr=(); uvs=(); branches=()
while IFS=$'\t' read -r s_id s_name s_needs s_touches s_uv s_branch; do
  [[ -z "$s_id" ]] && continue
  # "-" sentinel from parser → empty.
  [[ "$s_needs" == "-" ]] && s_needs=""
  [[ "$s_touches" == "-" ]] && s_touches=""
  [[ "$s_uv" == "-" ]] && s_uv=""
  ids+=("$s_id"); names+=("$s_name"); needs_arr+=("$s_needs")
  touches_arr+=("$s_touches"); uvs+=("$s_uv"); branches+=("$s_branch")
done <<< "$tsv"

n=${#ids[@]}

# Compute merged set (by slice id) and worktree-exists set.
merged_ids=""
inflight_ids=""
for ((i=0; i<n; i++)); do
  if is_merged "${branches[$i]}"; then
    merged_ids="$merged_ids ${ids[$i]}"
  fi
  s_wt="$wt_dir/${slug}-${ids[$i]}"
  if [[ -d "$s_wt" ]]; then
    inflight_ids="$inflight_ids ${ids[$i]}"
  fi
done

contains() { case " $1 " in *" $2 "*) return 0;; *) return 1;; esac; }

# Build candidate ready set: needs all merged, not already merged, not in flight.
ready_idx=()
for ((i=0; i<n; i++)); do
  contains "$merged_ids" "${ids[$i]}" && continue
  contains "$inflight_ids" "${ids[$i]}" && continue
  needs="${needs_arr[$i]}"
  ok=1
  if [[ -n "$needs" ]]; then
    IFS=',' read -r -a need_list <<< "$needs"
    for n_id in "${need_list[@]}"; do
      [[ -z "$n_id" ]] && continue
      if ! contains "$merged_ids" "$n_id"; then ok=0; break; fi
    done
  fi
  [[ "$ok" == "1" ]] && ready_idx+=("$i")
done

if [[ ${#ready_idx[@]} -eq 0 ]]; then
  if [[ -n "$inflight_ids" ]]; then
    echo "wt: no newly-ready slices. In flight:$inflight_ids" >&2
  else
    echo "wt: no ready slices (all merged or all blocked)" >&2
  fi
  exit 0
fi

# Conflict-check: serialize any ready pair that shares a touches path.
# Simpler: drop slice j if its touches set intersects an earlier ready slice's.
spawn_idx=()
spawn_touches=()
for i in "${ready_idx[@]}"; do
  conflict=0
  IFS=',' read -r -a my_paths <<< "${touches_arr[$i]}"
  for prev in "${spawn_touches[@]:-}"; do
    [[ -z "$prev" ]] && continue
    IFS=',' read -r -a prev_paths <<< "$prev"
    for p in "${my_paths[@]}"; do
      [[ -z "$p" ]] && continue
      for q in "${prev_paths[@]}"; do
        [[ -z "$q" ]] && continue
        if [[ "$p" == "$q" ]]; then conflict=1; break 3; fi
      done
    done
  done
  if [[ "$conflict" == "1" ]]; then
    echo "wt: deferring ${ids[$i]} (touches conflict with sibling ready slice)" >&2
  else
    spawn_idx+=("$i")
    spawn_touches+=("${touches_arr[$i]}")
  fi
done

if [[ "$mode" == "resolve" ]]; then
  echo "wt --resolve $ticket: merged={$merged_ids } inflight={$inflight_ids } spawning ${#spawn_idx[@]}"
else
  echo "wt --dag $ticket: spawning ${#spawn_idx[@]} ready slice(s)"
fi

plan_path="$HOME/.claude/plans/${plan_slug}.md"
review_rule="Review findings: apply blocker/major fixes directly in the PR branch (commit + push), do NOT post them as PR comments."

for i in "${spawn_idx[@]}"; do
  s_id="${ids[$i]}"
  s_name="${names[$i]}"
  s_branch="${branches[$i]}"
  s_slug="${slug}-${s_id}"
  s_wt="$wt_dir/${s_slug}"
  s_initial="Autonomous mode, DAG slice. Plan at ${plan_path}. Implement slice ${s_id} (${s_name}) only. Per-layer commits, run type-check + tests. After the slice is committed and pushed, STOP — do not run /ship and do not start another slice. The DAG resolver (\`wt --resolve ${ticket}\`) will re-spawn the next ready set after this slice merges. ${review_rule}"
  spawn_lane "$s_slug" "$s_branch" "$s_wt" "$s_initial" "${ticket}-${s_id}"
done
