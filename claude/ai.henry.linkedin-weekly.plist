<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.henry.linkedin-weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/henrypye/.dotfiles/scripts/weekly-linkedin.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/henrypye/.claude/linkedin-logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/henrypye/.claude/linkedin-logs/launchd.err.log</string>
</dict>
</plist>
