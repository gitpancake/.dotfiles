{
  "env": {
    "MCP_TIMEOUT": "10000",
    "MCP_TOOL_TIMEOUT": "20000",
    "CAVEMAN_DEFAULT_MODE": "ultra",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tmux-bell.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-waiting.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-idle.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/precheck-stop.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-active.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/debug-router.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/clear-handoff.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/lane-reaper.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-active.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-write-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/linear-ticket-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/lane-ctx-nudge.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": false,
    "ralph-skills@ralph-marketplace": false
  },
  "extraKnownMarketplaces": {
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ralph-marketplace": {
      "source": {
        "source": "github",
        "repo": "snarktank/ralph"
      }
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "fileCheckpointingEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": false,
  "voiceEnabled": false
}
