{
  "env": {
    "MCP_TIMEOUT": "10000",
    "MCP_TOOL_TIMEOUT": "20000",
    "CAVEMAN_DEFAULT_MODE": "ultra"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tmux-bell.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-waiting.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-idle.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/precheck-stop.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-active.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-handoff.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/turn-cap-warn.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/debug-router.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/search-intent-router.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/clear-handoff.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/lane-reaper.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-active.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-write-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/handoff-gate.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/linear-ticket-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/big-file-read-advisor.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-handoff.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tool-loop-warn.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/subagent-nudge.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "ralph-skills@ralph-marketplace": true
  },
  "extraKnownMarketplaces": {
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ralph-marketplace": {
      "source": {
        "source": "github",
        "repo": "snarktank/ralph"
      }
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "fileCheckpointingEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": false
}
