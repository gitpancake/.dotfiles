{
  "env": {
    "MCP_TIMEOUT": "10000",
    "MCP_TOOL_TIMEOUT": "20000",
    "CAVEMAN_DEFAULT_MODE": "ultra",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(bun test:*)",
      "Bash(bun type-check)",
      "Bash(bun run type-check)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(npx prettier:*)",
      "Bash(tmux list-windows:*)",
      "Bash(tmux list-sessions:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux new-window:*)",
      "Bash(tmux rename-window:*)",
      "Bash(tmux send-keys:*)",
      "Bash(wt:*)",
      "Bash(mdfind:*)",
      "Bash(mkdir:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(ps:*)",
      "Bash(which:*)",
      "Bash(pwd)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(~/.dotfiles/scripts/granola.py:*)",
      "Bash(~/.dotfiles/scripts/pocket.py:*)",
      "Bash(~/.dotfiles/scripts/linear-ticket.py:*)",
      "Bash(~/.dotfiles/scripts/linear-gql.py:*)",
      "Bash(~/.dotfiles/scripts/linear-brief.sh:*)",
      "Bash(~/.dotfiles/scripts/axiom.py:*)",
      "Bash(~/.dotfiles/scripts/langsmith.py:*)",
      "Bash(~/.claude/skills/wilson-memories/read_memories.py:*)",
      "Bash(~/.claude/scripts/devin-review.sh:*)",
      "Bash(~/.claude/scripts/lane-paint.sh:*)",
      "Bash(~/.claude/scripts/lane-revive.sh:*)",
      "Bash(~/.claude/scripts/lane-state-sweep.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(bun run src/server/scripts/deleteDocsByOrgId*)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tmux-bell.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-waiting.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-idle.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/precheck-stop.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-active.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/debug-router.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/clear-handoff.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/lane-reaper.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/agent-state-active.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-write-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/prod-db-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/lane-ctx-nudge.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "fileCheckpointingEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": false,
  "voiceEnabled": false
}
